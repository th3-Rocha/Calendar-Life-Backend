# Copy this file to ".env" (do not commit .env)

# ASP.NET Core environment
ASPNETCORE_ENVIRONMENT=Development

# PostgreSQL connection string (Npgsql)
# Example (Docker): Host=localhost;Port=5432;Database=calendar_life;Username=calendarlife;Password=calendarlife
CONNECTIONSTRINGS__DEFAULT=

# Placeholder API key (example only)
EXTERNAL_API_KEY=changeme
